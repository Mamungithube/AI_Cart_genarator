# ========================================================
# Production & Security Environment Configuration
# ========================================================

# AI Providers
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
OPENAI_API_KEY=

# Django Security & Core (In production: DEBUG=False and use a strong random secret)
DEBUG=False
DJANGO_SECRET_KEY=generate-a-strong-random-50-character-secret-key
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# API Authentication Secret Key (Required for /api/process-card/ and /api/enhance-card/)
API_SECRET_KEY=card_sec_9a7d3e5f1b2c4d8e0f6a5b4c3d2e1f0a

# HTTPS / SSL Security (Set to True if serving behind HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=31536000

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOW_ALL_ORIGINS=False

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
